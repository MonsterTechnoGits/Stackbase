# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=44300

# ─── SSL (self-signed, used for https://213.199.52.37:44300/) ────────────────
SSL_KEY_PATH=./certs/server.key
SSL_CERT_PATH=./certs/server.crt

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://192.168.0.100:3000
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://192.168.0.100:3000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/boilerplate

# ─── Better Auth ──────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret
BETTER_AUTH_URL=http://localhost:44300

# ─── Bootstrap admin user (created on first boot) ────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@1234
ADMIN_NAME=Super Admin

# ─── Session ──────────────────────────────────────────────────────────────────
SESSION_INACTIVITY_TIMEOUT_MINUTES=30

# ─── Optional logging ─────────────────────────────────────────────────────────
LOG_LEVEL=info
