{
  "name": "@stackbase/backend",
  "version": "1.0.0",
  "description": "Stackbase backend API — Node.js + Fastify 5",
  "private": true,
  "author": "Suman Dey <connect@sumandey.com> (https://sumandey.com)",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node dist/index.js",
    "build": "pnpm run prettier && pnpm run lint:fix && pnpm run lint && tsc --noEmit && tsup",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "prettier": "prettier --write \"src/**/*.ts\"",
    "pre-checks": "pnpm run prettier && pnpm run lint:fix && pnpm run lint && pnpm run build",
    "migration:generate": "drizzle-kit generate",
    "migration:push": "drizzle-kit migrate",
    "migration:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/sse": "^0.4.0",
    "@fastify/static": "^8.1.1",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@fastify/websocket": "^11.2.0",
    "better-auth": "^1.5.0",
    "drizzle-orm": "^0.45.0",
    "pg": "^8.20.0",
    "bcryptjs": "^3.0.0",
    "axios": "^1.13.0",
    "date-fns": "^4.1.0",
    "fastify": "^5.8.0",
    "fastify-plugin": "^5.0.0",
    "pino": "^9.14.0",
    "pino-roll": "^1.3.0",
    "uuid": "^9.0.1",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/uuid": "^9.0.8",
    "drizzle-kit": "^0.31.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.8.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.0",
    "typescript": "^6.0.0"
  }
}
