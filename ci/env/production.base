# Scanner Applications — production environment template
# This file is copied to /home/deploy/ScannerApplications/.env on every deploy.
# Keep secrets OUT of this file — inject them via GitHub Actions secrets or set manually on the server.
# Lines starting with # are ignored.

NODE_ENV=development

# Backend — also serves the static frontend on the same port
PORT=44300

# SSL — self-signed cert, persists outside the swapped app dir across deploys
SSL_KEY_PATH=/home/deploy/ScannerApplications/certs/server.key
SSL_CERT_PATH=/home/deploy/ScannerApplications/certs/server.crt

# Frontend public URL (used at Next.js build time — baked in at CI)
# Same origin as the backend now that Fastify serves the static export.
NEXT_PUBLIC_API_BASE_URL=https://213.199.52.37:44300
NEXT_PUBLIC_APP_URL=https://213.199.52.37:44300

# CORS — must match the frontend's actual origin exactly (scheme+host+port)
CORS_ORIGIN=https://213.199.52.37:44300

# SAP OData
SAP_ODATA_BASE_URL=https://tech.sapvista.com:44300/sap/opu/odata/sap/API_PURCHASEORDER_PROCESS_SRV/
SAP_PRODUCT_BASE_URL=
SAP_MATERIAL_STOCK_BASE_URL=
SAP_ODATA_CSRF_PATH=
SAP_SESSION_TTL_SECONDS=1800

# Logging
LOG_LEVEL=warn

# Auth
JWT_SECRET=90fe104e91d1b96512e29a16d7fcd705799d13ce2aefe260c132e9c79f4352a2
